{
  "name": "443-elevatr",
  "version": "2.1.0",
  "private": true,
  "scripts": {
    "clean": "rimraf dist",
    "build": "npm run clean && npx @tailwindcss/cli -i ./src/main.css -o ./dist/output.css && webpack --config webpack.prod.ts",
    "build:analyze": "ANALYZE=true npm run build",
    "dev": "webpack serve --config webpack.dev.ts --open",
    "preview": "npm run build && npx serve dist",
    "start": "echo 'This site is intended to be served as static files. Run via `npm run build` instead.' && exit 1"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@babel/preset-env": "^8.0.2",
    "@babel/preset-react": "^8.0.1",
    "@babel/preset-typescript": "^8.0.1",
    "@tailwindcss/cli": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/webpack-bundle-analyzer": "^4.7.0",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "babel-loader": "^10.1.1",
    "css-loader": "^7.1.4",
    "eslint": "^8.30.0",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-standard-with-typescript": "^24.0.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-jsx-a11y": "^6.9.0",
    "eslint-plugin-n": "^15.6.0",
    "eslint-plugin-promise": "^6.1.1",
    "eslint-plugin-react": "^7.35.0",
    "eslint-plugin-tailwindcss": "^3.17.4",
    "postcss": "^8.4.20",
    "postcss-loader": "^8.1.1",
    "rimraf": "^6.0.1",
    "style-loader": "^4.0.0",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "webpack-cli": "^7.2.2"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "clsx": "^2.1.1",
    "copy-webpack-plugin": "^14.0.0",
    "html-webpack-plugin": "^5.6.0",
    "motion": "^13.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "webpack": "^5.94.0",
    "webpack-bundle-analyzer": "^5.3.1",
    "webpack-dev-server": "^6.0.0",
    "webpack-merge": "^6.0.1"
  }
